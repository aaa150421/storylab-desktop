{
  "name": "storylab-desktop",
  "version": "1.2.6",
  "description": "이야기공방 데스크톱 앱",
  "main": "main.js",
  "author": "StoryLab",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable",
    "publish:win": "electron-builder --win nsis --x64 --publish always",
    "release": "node release.js"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "kr.storylab.desktop",
    "productName": "이야기공방",
    "files": [
      "main.js",
      "storylab.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "aaa150421",
        "repo": "storylab-desktop",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aaa150421/storylab-desktop.git"
  },
  "allowScripts": {
    "electron@34.5.8": true
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
